# Silvia Art Collective Etsy Seller App
ETSY_KEYSTRING=PASTE_IN_RENDER_ONLY
ETSY_SHARED_SECRET=PASTE_IN_RENDER_ONLY
ETSY_REFRESH_TOKEN=PASTE_AFTER_ETSY_AUTHORIZATION
ETSY_CALLBACK_URL=https://silvia-sensaria-bridge.onrender.com/etsy/callback

# Cloudflare R2 artwork storage
R2_ACCOUNT_ID=PASTE_IN_RENDER_ONLY
R2_ACCESS_KEY_ID=PASTE_IN_RENDER_ONLY
R2_SECRET_ACCESS_KEY=PASTE_IN_RENDER_ONLY
R2_BUCKET_NAME=silvia-art-collective
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto

# Private app login
ADMIN_PASSWORD=CHOOSE_A_STRONG_PASSWORD

# Fulfillment
SILVIA_DEFAULT_SHIPPING_METHOD=Standard
SILVIA_FALLBACK_PHONE=1111111111
