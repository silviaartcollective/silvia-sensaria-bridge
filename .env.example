# Silvia Art Collective Etsy Seller App
ETSY_KEYSTRING=PASTE_IN_RENDER_ONLY
ETSY_SHARED_SECRET=PASTE_IN_RENDER_ONLY
ETSY_REFRESH_TOKEN=PASTE_AFTER_ETSY_AUTHORIZATION
ETSY_CALLBACK_URL=https://silvia-sensaria-bridge.onrender.com/etsy/callback
ETSY_WEBHOOK_SECRET=PASTE_IN_RENDER_ONLY

# Fulfillment / shop identity
SILVIA_ETSY_SHOP_ID=SET_AFTER_AUTHORIZATION
SILVIA_DEFAULT_SHIPPING_METHOD=Standard
SILVIA_FALLBACK_PHONE=1111111111

# Multi-provider fulfillment safety
FULFILLMENT_MODE=shadow
FULFILLMENT_LIVE_SUBMISSION_ENABLED=false
PRODIGI_FULFILLMENT_ENABLED=false
ARTELO_FULFILLMENT_ENABLED=false
ARTELO_TEST_ORDER_ENABLED=false
PRINTSHRIMP_FULFILLMENT_ENABLED=false

# POD provider APIs
# Sensaria currently uses the approved Sensaria GO / CSV workflow rather than a stored API secret.
PRINTIFY_API_TOKEN=PASTE_IN_RENDER_ONLY
ARTELO_API_KEY=PASTE_IN_RENDER_ONLY
PRODIGI_API_KEY=PASTE_IN_RENDER_ONLY
PRINTSHRIMP_API_KEY=PASTE_IN_RENDER_ONLY

# Cloudflare R2 private artwork storage
R2_ACCOUNT_ID=PASTE_IN_RENDER_ONLY
R2_ACCESS_KEY_ID=PASTE_IN_RENDER_ONLY
R2_SECRET_ACCESS_KEY=PASTE_IN_RENDER_ONLY
R2_BUCKET_NAME=silvia-art-collective
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto

# App
ADMIN_PASSWORD=PASTE_IN_RENDER_ONLY
